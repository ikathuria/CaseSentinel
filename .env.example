# --- Gemini (required for live drafting; M0 runs offline without it) ---
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL_MAIN=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite

# --- Storage (local-first; flip to firestore for the deploy stretch) ---
STORE_BACKEND=local            # local | firestore
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Demo controls ---
FAILURE_INJECTION_ENABLED=true
